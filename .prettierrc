{
  "singleQuote": true,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "importOrder": [
    "<BUILTIN_MODULES>",
    "^(react/(.*)$)|^(react$)",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/main/(.*)$",
    "^@/preload/(.*)$",
    "^@/renderer/(.*)$",
    "",
    "^@/app/(.*)$",
    "",
    "^@/pages/(.*)$",
    "",
    "^@/layouts/(.*)$",
    "",
    "^@/widgets/(.*)$",
    "",
    "^@/features/(.*)$",
    "",
    "^@/entities/(.*)$",
    "",
    "^@/shared/(.*)$",
    "",
    "^[./]"
  ],
  "importOrderTypeScriptVersion": "5.0.0",
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"]
}
